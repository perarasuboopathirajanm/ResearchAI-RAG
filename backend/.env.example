# ---------- Answer model ----------
# local = self-hosted model via Ollama (private, offline, no API key)  [default]
# groq  = Groq cloud API (needs GROQ_API_KEY; text is sent to Groq)
LLM_PROVIDER=local

# Local model settings (install Ollama from https://ollama.com, then: ollama pull llama3.2:3b)
OLLAMA_URL=http://localhost:11434
LOCAL_MODEL=llama3.2:3b
LLM_TIMEOUT=300

# Optional cloud provider
GROQ_API_KEY=
MODEL_NAME=openai/gpt-oss-20b

# ---------- Server ----------
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
